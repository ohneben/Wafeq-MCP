# Copy to .env and fill in. docker-compose reads this file automatically.
# .env is git-ignored — never commit a real key.

# ─── Credentials (pick ONE scheme) ────────────────────────────────────────────
# A) Private, single-organization API key. Sent as `Authorization: Api-Key <key>`.
#    Wafeq → Settings → Developer → API keys.
WAFEQ_API_KEY=your-wafeq-api-key-here

# B) OAuth2 app token. Sent as `Authorization: Bearer <token>`.
#    Setting this instead of WAFEQ_API_KEY switches the scheme automatically.
WAFEQ_ACCESS_TOKEN=

# Force a scheme when both are set. "api-key" or "bearer". Normally leave empty.
WAFEQ_AUTH_SCHEME=

# ─── Server ──────────────────────────────────────────────────────────────────
# "stdio" for a local launcher (Claude Desktop, Claude Code), "http" for the
# always-on Streamable HTTP server. docker-compose sets this to http for you.
MCP_TRANSPORT=stdio

# Host port to publish the HTTP server on (the container always listens on 8765).
PORT=8765

# Shared secret clients must send as "Authorization: Bearer <token>" on /mcp.
# Empty = no auth. SET THIS before exposing the server beyond localhost.
MCP_SHARED_TOKEN=

# ─── Wafeq API ───────────────────────────────────────────────────────────────
# Override the API base URL. Defaults to https://api.wafeq.com/v1
WAFEQ_API_BASE_URL=

# Use a different OpenAPI document instead of the bundled spec/wafeq-public-api.json
WAFEQ_OPENAPI_PATH=

# ─── Tool catalogue ──────────────────────────────────────────────────────────
# Comma-separated resource groups to expose. Empty = all 251 generated tools.
# e.g. WAFEQ_TOOL_GROUPS=invoices,bills,contacts,reports,accounts
# Run `npm run list-tools` to see every accepted group name.
WAFEQ_TOOL_GROUPS=

# ─── Resilience (safe defaults; tune only if you need to) ────────────────────
# Client-side throttle. 0 disables it. Wafeq publishes no numeric rate limit,
# so the default is deliberately conservative.
WAFEQ_MAX_REQUESTS=20
WAFEQ_RATE_WINDOW_MS=10000
# Retries on 429/5xx/network errors, with jittered backoff and Retry-After.
WAFEQ_MAX_RETRIES=3
# Per-attempt timeout in milliseconds.
WAFEQ_TIMEOUT_MS=30000

# ─── File uploads ────────────────────────────────────────────────────────────
# Allow upload tools to read files from THIS machine's filesystem via `file_path`.
# Leave false unless you need it: with it on, anything that can call the server
# can ask it to read a local file. Base64 uploads work either way.
WAFEQ_ALLOW_LOCAL_FILE_UPLOAD=false
# Maximum decoded upload size in bytes (default 25 MiB).
WAFEQ_MAX_UPLOAD_BYTES=26214400
